# ==========================================
# Supabase PostgreSQL (apps/api + Prisma)
# ==========================================
# Пулер соединений (runtime API)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Прямое соединение (миграции Prisma: db:push / migrate)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# ==========================================
# Supabase Realtime
# ==========================================
# Web (Vite) — вшивается на build / Vercel
VITE_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOi..."

# API broadcast (apps/api/src/lib/broadcast.ts) — пока отдельный префикс; TODO унифицировать в Фазе 4
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."

# ==========================================
# Upstash Redis (локи столов + сессии бота)
# ==========================================
UPSTASH_REDIS_REST_URL="https://[INSTANCE].upstash.io"
UPSTASH_REDIS_REST_TOKEN="AX..."

# ==========================================
# Telegram Bot (apps/bot)
# ==========================================
