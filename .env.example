# Файл кладётся в корень репозитория (рядом с package.json), не в apps/.
# API, Vite и `pnpm db:push` / `pnpm db:seed` читают именно его.
# Пока DATABASE_URL пустой, меню и столы берутся из моков.
# На Vercel те же ключи — Project → Environment Variables (файл сюда не копировать).
# ==========================================
# Supabase PostgreSQL (apps/api + Prisma)
# ==========================================
# Transaction pooler (6543). Если порт закрыт файрволом — Prisma сам возьмёт DIRECT_URL (5432).
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler (5432) — миграции и запасной runtime. Не db.PROJECT.supabase.co (там только IPv6).
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# ==========================================
# Supabase Realtime (единый источник, Фаза 4)
# ==========================================
# Предпочтительно — без префикса (API + документация)
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOi..."

# Web (Vite) — вшивается на build / Vercel (те же значения)
VITE_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOi..."

# Legacy-фолбэк для API (если SUPABASE_* / VITE_* не заданы)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."

# ==========================================
# Upstash Redis (локи столов + сессии бота)
# ==========================================
UPSTASH_REDIS_REST_URL="https://[INSTANCE].upstash.io"
UPSTASH_REDIS_REST_TOKEN="AX..."

# ==========================================
# Telegram Bot (apps/bot)
# ==========================================
BOT_TOKEN="123456789:AA..."
# Секрет заголовка x-bot-secret. Пусто — API берёт BOT_TOKEN.
BOT_API_SECRET=""
# Базовый URL API для бота (без хвоста /api)
API_URL="http://localhost:4000"
# Публичный URL apps/web (кнопка Telegram Mini App / Vercel)
# Публичный HTTPS сайта (Mini App / кнопка «Приложение»). localhost Telegram не откроет.
WEBAPP_URL="https://your-app.vercel.app"

# ==========================================
# API
# ==========================================
PORT=4000

# Staff JWT (apps/api auth)
JWT_SECRET="change-me-in-production"
